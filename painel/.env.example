# PostgREST do banco de chat
PGRST_BASE_URL=https://postrestchat.todo-tips.com
PGRST_JWT_SECRET=__troque_pelo_secret__
PGRST_ROLE=__troque_pelo_role__

# API externa de médicos
MEDICOS_API_URL=https://reportapi.todo-tips.com/api/lista_medicos
MEDICOS_CACHE_TTL_HOURS=24

# Origens que podem embedar o painel via iframe (CSV)
ALLOWED_IFRAME_ORIGINS=https://app.chatmasterveloz.com,https://app2.chatmasterveloz.com

# Basic Auth (opcional): se ambas vazias/ausentes, middleware fica inativo e o
# painel responde sem prompt. Ative apenas se quiser proteger todo o painel
# com user/senha digitada no browser.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=

# Runtime
NODE_ENV=production
PORT=3000
